{
  "manifest_version": 3,
  "name": "PhishShield",
  "description": "Detects suspicious login forms and explains phishing risk before users submit credentials.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*"],
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "PhishShield"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "phishshield@example.local"
    }
  }
}
